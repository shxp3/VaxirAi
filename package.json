{
  "name": "vaxir-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "register": "node --env-file-if-exists=.env --import tsx src/register.ts",
    "smoke:ai": "node --env-file-if-exists=.env --import tsx src/smoke-ai.ts"
  },
  "dependencies": { "discord.js": "14.27.0" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "4.23.13", "typescript": "7.0.2" }
}
