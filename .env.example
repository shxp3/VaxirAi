DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands immediately in one development server.
DISCORD_GUILD_ID=
DEFAULT_AI_PROVIDER=gemini
# Enter a model available to your account; no model is assumed to be free.
DEFAULT_AI_MODEL=
DEFAULT_AI_API_KEY=
DEFAULT_AI_BASE_URL=
# 32 random bytes, base64. See README for generation command.
ENCRYPTION_KEY=
DATABASE_URL=./data/vaxir.sqlite
USER_RATE_LIMIT=5
RATE_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT=60
CONTEXT_MESSAGE_LIMIT=20
MAX_PROMPT_CHARS=20000
MAX_ATTACHMENT_BYTES=65536
MAX_IMAGE_BYTES=2097152
MAX_ATTACHMENTS=3
MAX_OUTPUT_TOKENS=1024
MAX_RESPONSE_CHARS=12000
AI_TIMEOUT_MS=45000
MAX_CONCURRENT_REQUESTS=8
MEMORY_TTL_HOURS=168
MESSAGE_CONTENT_ENABLED=true
# Global web grounding configured only by the bot owner. Empty key disables it.
BRAVE_SEARCH_API_KEY=
SEARCH_MODE=auto
SEARCH_COUNTRY=ALL
SEARCH_LANGUAGE=en
# Optional restriction: exact custom HTTPS base URLs, comma-separated.
# Empty allows public HTTPS gateways configured by server administrators.
# Example: https://llm.example.com/v1
CUSTOM_AI_ALLOWED_BASE_URLS=
